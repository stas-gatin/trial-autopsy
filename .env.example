# Copy to .env and fill in. Never commit .env.

# --- Mode -------------------------------------------------------------
# true: no network, no keys. Uses recorded data and recorded model outputs
# in data/cache and data/llm_cache. Works for the demo cases out of the box.
SAMPLE_MODE=false
PORT=8000

# --- Model providers ----------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-key-here
# NVIDIA NIM (OpenAI-compatible endpoint)
NVIDIA_API_KEY=your-nvidia-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Meterless Runtime (Nightshift): the primary model provider. The NVIDIA key goes in Nightshift's Providers tab;
# the app needs only Nightshift's URL and the API key from its Console. Each step asks for a routing mode
# (meterless/deep, meterless/fast or meterless/auto) and Nightshift picks the Nemotron lane that answers.
# In Nightshift: Setup -> Preferences -> "Tier-split enabled" off, and bind the app to "fast" in the Console.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=

# Role -> "provider:model". Providers: meterless | anthropic | nvidia | openai | replay
# If a provider's key is missing, the role falls back to replay (recorded outputs).
# Extraction and read-through copy numbers with verbatim quotes, which works best with reasoning off; Nightshift
# does not pass the reasoning switch on, so they call NVIDIA's API directly (NVIDIA_API_KEY above).
ROLE_REASONING=meterless:meterless/deep
ROLE_EXTRACTION=nvidia:nvidia/nemotron-3.5-super-vl-120b-a12b
ROLE_CRITIC=meterless:meterless/fast
ROLE_REPORTER=meterless:meterless/fast

# Optional generic OpenAI-compatible provider ("openai:<model>")
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Data sources -------------------------------------------------------
# SEC EDGAR asks for a contact e-mail in the User-Agent.
CONTACT_EMAIL=you@example.com

# --- Zetaris data layer (optional) ---------------------------------------
# With these set, ClinicalTrials.gov, Europe PMC and SEC EDGAR are read through Zetaris
# (REST session tables + Lightning SQL); literature is date-filtered in SQL. Any Zetaris
# failure falls back to the direct request. SAMPLE_MODE never calls Zetaris.
# Key: Zetaris UI -> Management -> API Tokens. Org ID: Management -> Organisation -> ID.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
SOURCE_ZETARIS=true
