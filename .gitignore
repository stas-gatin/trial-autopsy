# Runtime output. The logs of the recorded live runs are committed (logs/trace-*, logs/world-*), as the
# hackathon asks; any other run's logs and every offline replay (logs/replay/, data/runs/replay/) stay local.
logs/*.jsonl
!logs/trace-bt-*.jsonl
!logs/world-bt-*.jsonl
!logs/trace-example-*.jsonl
!logs/world-example-*.jsonl
logs/replay/
data/cache/
data/world/
data/runs/
data/llm_cache_fresh/

# Meterless World Model service: runtime state and dependencies
data/meterless/
services/meterless/node_modules/

